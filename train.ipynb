    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.feature_selection import chi2\n",
    "\n",
    "K = 12\n",
    "feature_names = preprocessor.get_feature_names_out()\n",
    "encoded_cols = []\n",
    "for group in ['categorical', 'boolean']:\n",
    "    encoded_cols.extend(feature_names[preprocessor.output_indices_[group]].tolist())\n",
    "numeric_cols = feature_names[preprocessor.output_indices_['remainder']].tolist()\n",
    "\n",
    "X_chi2 = X_train.loc[:, encoded_cols]\n",
    "if not np.isfinite(X_chi2.to_numpy()).all() or (X_chi2 < 0).any().any():\n",
    "    raise ValueError('Các cột dùng chi2 phải hữu hạn và không âm.')\n",
    "\n",
    "scores, p_values = chi2(X_chi2, y_train)\n",
    "chi2_results = pd.DataFrame({\n",
    "    'feature': encoded_cols,\n",
    "    'chi2': scores,\n",
    "    'p_value': p_values,\n",
    "}).sort_values('chi2', ascending=False, kind='stable').reset_index(drop=True)\n",
    "\n",
    "valid_results = chi2_results[np.isfinite(chi2_results['chi2'])]\n",
    "if not isinstance(K, int) or not 1 <= K <= len(valid_results):\n",
    "    raise ValueError(f'K phải là số nguyên từ 1 đến {len(valid_results)}.')\n",
    "top_cols = valid_results.head(K)['feature'].tolist()\n",
    "selected_cols = numeric_cols + top_cols\n",
    "chi2_results['selected'] = chi2_results['feature'].isin(top_cols)\n",
    "\n",
    "X_train_selected = X_train.loc[:, selected_cols].copy()\n",
    "X_test_selected = X_test.loc[:, selected_cols].copy()\n",
    "\n",
    "print(f'Chọn {K}/{len(encoded_cols)} cột one-hot/boolean, giữ {len(numeric_cols)} cột numerical.')\n",
    "print('X_train_selected:', X_train_selected.shape)\n",
    "print('X_test_selected:', X_test_selected.shape)\n",
    "display(chi2_results)\n"
   ]
  },
