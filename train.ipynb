   "source": [
    "categorical_cols = X_object.columns.tolist() + X_bool.columns.tolist()\n",
    "summaries = []\n",
    "for col in categorical_cols:\n",
    "    summary = (\n",
    "        df.groupby(col)[\"is_fraud\"]\n",
    "        .agg(sample_count=\"size\", fraud_count=\"sum\", fraud_rate=\"mean\")\n",
    "        .sort_values(\"fraud_rate\", ascending=False)\n",
    "    )\n",
    "    summary[\"fraud_rate\"] *= 100\n",
    "    summaries.append((col, summary))\n",
    "\n",
    "    print(f\"\\n--- {col} (fraud_rate: %) ---\")\n",
    "    print(summary)"
